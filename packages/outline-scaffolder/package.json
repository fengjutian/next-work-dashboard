{
  "name": "@next-work-dashboard/outline-scaffolder",
  "version": "0.1.0",
  "description": "Reusable outline scaffolding, editorial analysis, and publishing UI foundations",
  "type": "module",
  "license": "MIT",
  "files": ["dist", "README.md"],
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": ["dist/core/index.d.ts"],
      "react": ["dist/react/index.d.ts"],
      "web": ["dist/web/index.d.ts"],
      "tauri": ["dist/tauri/index.d.ts"]
    }
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./react": { "types": "./dist/react/index.d.ts", "import": "./dist/react/index.js" },
    "./web": { "types": "./dist/web/index.d.ts", "import": "./dist/web/index.js" },
    "./tauri": { "types": "./dist/tauri/index.d.ts", "import": "./dist/tauri/index.js" },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && npm publish --access public --provenance",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:styles",
    "build:styles": "tailwindcss -c tailwind.config.cjs -i src/styles.css -o dist/styles.css --minify",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "antd": "^6.5.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.4.5",
    "vitest": "^2.1.9"
  },
  "publishConfig": { "access": "public" }
}
