{
  "name": "next-work-dashboard",
  "productName": "next-work-dashboard",
  "version": "0.5.0",
  "description": "next-work-dashboard — 本地优先的 AI 工作台",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "prepare:native": "node scripts/prepare-native-dependencies.mjs",
    "prepare:package-output": "node scripts/prepare-package-output.mjs",
    "build:rag-worker": "node scripts/build-rag-worker.mjs",
    "build:disk-scanner": "node scripts/build-disk-scanner.mjs",
    "build:net-probe": "node scripts/build-net-probe.mjs",
    "build:mycast": "node scripts/build-mycast.mjs",
    "build:voice-engine": "node scripts/build-voice-engine.mjs",
    "fetch:mpv": "node scripts/fetch-mpv.mjs",
    "plugin:pack": "node scripts/pack-plugin.mjs",
    "plugin:catalog": "node scripts/build-plugin-catalog.mjs",
    "size:report": "node scripts/report-package-size.mjs",
    "size:check": "node scripts/report-package-size.mjs --check",
    "start": "npm run prepare:native && npm run build:rag-worker && npm run build:disk-scanner && npm run build:net-probe && npm run build:mycast && npm run build:voice-engine && electron-forge start",
    "package": "npm run prepare:package-output && npm run prepare:native && npm run build:rag-worker && npm run build:disk-scanner && npm run build:net-probe && npm run build:mycast && npm run build:voice-engine && node scripts/run-forge.mjs package",
    "make": "npm run prepare:package-output && npm run prepare:native && npm run build:rag-worker && npm run build:disk-scanner && npm run build:net-probe && npm run build:mycast && npm run build:voice-engine && node scripts/run-forge.mjs make",
    "publish": "npm run prepare:package-output && npm run prepare:native && npm run build:rag-worker && npm run build:disk-scanner && npm run build:net-probe && npm run build:mycast && npm run build:voice-engine && node scripts/run-forge.mjs publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "check:docs": "node scripts/check-markdown-links.mjs",
    "check:encoding": "node scripts/check-utf8.mjs",
    "knowledge:check": "vite-node scripts/run-knowledge-cli.ts check --root ..",
    "knowledge:impact": "vite-node scripts/run-knowledge-cli.ts impact --root ..",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:ipc && npm run check:docs && npm run check:encoding",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "electron",
    "ai",
    "prompt",
    "deepseek",
    "chatgpt"
  ],
  "author": "fengjutian <fjutian@foxmail.com>",
  "license": "MIT",
