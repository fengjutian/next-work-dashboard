/**
 * Wiki Link 高亮 Tiptap 扩展。
 *
 * 用 ProseMirror Decoration 给 [[…]] 文本加上可视化样式（蓝色下划线）。
 * 不修改文档结构（保持 [[…]] 是普通文本，方便 roundtrip）。
 *
 * 实现：
 *  - Plugin 监听 doc 变化，每笔 transaction 重新扫描所有 [[…]]
 *  - 跳过 code mark 内部的 [[…]]
 *  - Decoration.inline 加 class `md-wiki-link`
 */

import { Extension } from '@tiptap/core';
import { Plugin, PluginKey, type EditorState } from '@tiptap/pm/state';
import { Decoration, DecorationSet } from '@tiptap/pm/view';
import type { Node as PMNode } from '@tiptap/pm/model';

const WIKI_LINK_PATTERN = /\[\[([^\]|#]+)(?:#[^\]|]+)?(?:\|([^\]]+))?\]\]/g;
const PLUGIN_KEY = new PluginKey<DecorationSet>('markdownEditorWikiLinkHighlight');

function collectRanges(doc: PMNode): Array<{ from: number; to: number }> {
  const ranges: Array<{ from: number; to: number }> = [];
  doc.descendants((node, nodePos) => {
    if (!node.isText) return true;
    if (node.marks.some((m) => m.type.name === 'code')) return true;
    const text = node.text ?? '';
    WIKI_LINK_PATTERN.lastIndex = 0;
    let m: RegExpExecArray | null;
    while ((m = WIKI_LINK_PATTERN.exec(text)) !== null) {
      if (m[0].length === 0) {
        WIKI_LINK_PATTERN.lastIndex += 1;
        continue;
      }
      ranges.push({ from: nodePos + m.index, to: nodePos + m.index + m[0].length });
    }
    return true;
  });
  return ranges;
}

function buildDecorations(doc: PMNode): DecorationSet {
  const ranges = collectRanges(doc);
  return DecorationSet.create(
    doc,
    ranges.map((r) =>
      Decoration.inline(r.from, r.to, {
        class: 'md-wiki-link',
      }),
    ),
  );
}

export const WikiLinkHighlightExtension = Extension.create({
  name: 'markdownEditorWikiLinkHighlight',
  addProseMirrorPlugins() {
    return [
      new Plugin<DecorationSet>({
        key: PLUGIN_KEY,
        state: {
          init: (_, state) => buildDecorations(state.doc),
          apply(tr, _old, _oldState, newState) {
            if (!tr.docChanged) return _old;
            return buildDecorations(newState.doc);
          },
        },
        props: {
          decorations(state) {
            return PLUGIN_KEY.getState(state) ?? DecorationSet.empty;
          },
        },
      }),
    ];
  },
});
